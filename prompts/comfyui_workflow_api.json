{
  "1": {"class_type": "CheckpointLoaderSimple",
        "inputs": {"ckpt_name": "CHANGE_ME_sdxl_checkpoint.safetensors"}},
  "2": {"class_type": "CLIPTextEncode",
        "inputs": {"text": "__PROMPT__", "clip": ["1", 1]}},
  "3": {"class_type": "CLIPTextEncode",
        "inputs": {"text": "__NEGATIVE__", "clip": ["1", 1]}},
  "4": {"class_type": "LoadImage",
        "inputs": {"image": "__CONTROL__"}},
  "5": {"class_type": "ImageScale",
        "inputs": {"image": ["4", 0], "upscale_method": "nearest-exact",
                   "width": 1024, "height": 1024, "crop": "disabled"}},
  "6": {"class_type": "VAEEncode",
        "inputs": {"pixels": ["5", 0], "vae": ["1", 2]}},
  "7": {"class_type": "KSampler",
        "inputs": {"model": ["1", 0], "seed": "__SEED__", "steps": 30, "cfg": 6.5,
                   "sampler_name": "dpmpp_2m", "scheduler": "karras",
                   "positive": ["2", 0], "negative": ["3", 0],
                   "latent_image": ["6", 0], "denoise": 0.62}},
  "8": {"class_type": "VAEDecode",
        "inputs": {"samples": ["7", 0], "vae": ["1", 2]}},
  "9": {"class_type": "SaveImage",
        "inputs": {"images": ["8", 0], "filename_prefix": "hoh_sprite"}}
}